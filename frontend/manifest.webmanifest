{
  "name": "Commons",
  "short_name": "Commons",
  "description": "A small public common. Anyone can read; you need an account to write.",
  "id": "/",
  "start_url": "./",
  "scope": "./",
  "lang": "en",
  "dir": "ltr",
  "categories": ["social", "news"],
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "background_color": "#0c1315",
  "theme_color": "#0c1315",
  "icons": [
    { "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Write a post",
      "short_name": "Write",
      "description": "Open the composer on a blank post.",
      "url": "./#/compose",
      "icons": [{ "src": "./assets/icons/shortcut-compose.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Your shelf",
      "short_name": "Shelf",
      "description": "The posts you have saved to read again.",
      "url": "./#/shelf",
      "icons": [{ "src": "./assets/icons/shortcut-shelf.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Notifications",
      "short_name": "Notifications",
      "description": "Replies and comments on what you have written.",
      "url": "./#/notifications",
      "icons": [{ "src": "./assets/icons/shortcut-notifications.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "./assets/screenshots/feed-wide.png",
      "sizes": "2200x1600",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The feed — what people have written, ranked by votes and by age."
    },
    {
      "src": "./assets/screenshots/post-wide.png",
      "sizes": "2200x1600",
      "type": "image/png",
      "form_factor": "wide",
      "label": "A post, set in the reading face the whole app is arranged around."
    },
    {
      "src": "./assets/screenshots/colophon-wide.png",
      "sizes": "2200x1600",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The colophon — how the app is built, and what is honest about the demo."
    },
    {
      "src": "./assets/screenshots/feed-narrow.png",
      "sizes": "824x1648",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The feed — what people have written, ranked by votes and by age."
    },
    {
      "src": "./assets/screenshots/post-narrow.png",
      "sizes": "824x1648",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "A post, set in the reading face the whole app is arranged around."
    },
    {
      "src": "./assets/screenshots/colophon-narrow.png",
      "sizes": "824x1648",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The colophon — how the app is built, and what is honest about the demo."
    }
  ]
}
