# Copy to a `.env` at the repo root (not here — config.py builds the path from
# __file__ and looks two levels up, so `uvicorn`, `pytest` and `alembic` all
# find it whichever directory you launch them from).

# Database
# Replace these values with your local or remote PostgreSQL credentials.
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_db_password_here
DATABASE_NAME=social_feed_db


# Auth
# Generate the secret with:  openssl rand -hex 32
# There is no default for it on purpose — the app refuses to start without one
# rather than falling back to something committed to a public repo.
SECRET_KEY=paste_your_generated_secret_key_here
ALGORITHM=HS256

# Minutes. Short on purpose: the access token no longer *is* the session, it is
# the thing /auth/refresh quietly replaces. Raising this back to an hour would
# undo most of what splitting the two tokens bought.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Days. How long a browser stays signed in without typing a password again.
REFRESH_TOKEN_EXPIRE_DAYS=14

# Put `Secure` on the refresh cookie, so the browser will only ever send it
# over https.
#
#   development:  false — a Secure cookie is dropped outright over plain http,
#                 and every development machine is plain http
#   production:   TRUE. Leaving it false behind TLS means the one credential
#                 this app can't afford to lose travels in the clear the first
#                 time somebody types the http:// address.
COOKIE_SECURE=false


# Operational (defaults live in backend/app/config.py)
# ENVIRONMENT=production also turns on HSTS; see the security headers in main.py.
ENVIRONMENT=development
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
