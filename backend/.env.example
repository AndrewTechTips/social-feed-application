# Database Configuration
# Replace these values with your local or remote PostgreSQL credentials
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_db_password_here
DATABASE_NAME=social_feed_db


# JWT (JSON Web Token) Authentication
# To generate a secure secret key, run this in your terminal: openssl rand -hex 32
SECRET_KEY=paste_your_generated_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60